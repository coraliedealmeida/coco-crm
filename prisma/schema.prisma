generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  LINKEDIN
  INSTAGRAM
  BOTH
}

// Parcours choisi à la création (cf. formulaire Nouvelle marque) : détermine si la fiche
// affiche "Plateforme cible" (routine) ou "Source" (prise de contact hors RS). Null = marque
// créée avant cette distinction, ou les deux infos ont été renseignées depuis : la fiche
// affiche alors les deux champs.
enum AcquisitionPath {
  ROUTINE
  CONTACT
  // Client créé directement (bouton "+ Nouveau client" ou import), sans passage par le Pipeline :
  // ni plateforme ni date d'engagement n'ont de sens ici, la fiche les masque par défaut.
  DIRECT
}

enum PipelineStatus {
  ROUTINE_ENGAGEMENT
  PREMIER_DM
  RELANCE_1
  RELANCE_2
  GHOSTE
  EN_DISCUSSION
  APPEL_PREVU
  DEVIS_A_FAIRE
  DEVIS_ENVOYE
  RELANCE_DEVIS_1
  RELANCE_DEVIS_2
  DEVIS_ACCEPTE
  DEVIS_REFUSE
  ARCHIVE
  PAS_MAINTENANT
}

model Brand {
  id                  String         @id @default(cuid())
  name                String
  emoji               String?
  platform            Platform
  acquisitionPath     AcquisitionPath?
  sector              String
  source              String
  notes               String?
  engagementStartDate DateTime
  pipelineStatus      PipelineStatus @default(ROUTINE_ENGAGEMENT)
  contactName         String?
  contactRole         String?
  lastContactDate     DateTime?
  nextActionDate      DateTime?
  messageUsed         String?
  potentialRevenue    Float?
  discoveryNotes      Json?
  archivedAt          DateTime?
  reconsiderDate      DateTime?
  // Dernier passage en routine d'engagement (like/commentaire) — sert à espacer les passages
  // dans le temps plutôt que de repasser sur la marque tous les jours.
  lastEngagementAt         DateTime?
  // Index du contact ciblé lors du dernier passage (discoveryNotes.allContacts), pour faire
  // tourner automatiquement entre les différentes personnes d'intérêt d'une même marque.
  lastEngagementContactIndex Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  contactHistory ContactHistoryEntry[]
  reminders      Reminder[]
  client         Client?
  prospectImport ProspectImport?
  contacts       BrandContact[]
}

// Personne d'intérêt identifiée pour une marque (ex : notée dans le Suivi, ou repérée sur
// LinkedIn) — gérée directement depuis la fiche, alimente la rotation en routine d'engagement
// (une personne différente ciblée à chaque passage plutôt que toujours la même).
model BrandContact {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  profileUrl String?
  platform   String   @default("LINKEDIN") // "LINKEDIN" | "INSTAGRAM"
  createdAt  DateTime @default(now())
}

model ProspectImport {
  id                  String    @id @default(cuid())
  // "INSTAGRAM" | "LINKEDIN" | "BOTH"
  platform            String
  // Nom brut de la marque/entreprise (Company LinkedIn ou handle Instagram)
  rawName             String
  // Handle Instagram si applicable
  handle              String?
  // URL du profil Instagram ou page LinkedIn entreprise
  profileUrl          String?
  // Contacts connus : [{ name, position, profileUrl, platform }]
  contacts            Json      @default("[]")
  brandCategory       String?   // "GRANDE_MARQUE" | "PME_STARTUP" | "INDEPENDANT"
  status              String    @default("PENDING") // PENDING | OUI | NON | PLUS_TARD
  enrichedAt          DateTime?
  enrichedName        String?
  enrichedSummary     String?
  deepEnrichedAt      DateTime?
  enrichedRevenue     String?
  enrichedFunding     String?
  enrichedWebsite     String?
  enrichedCity        String?
  // Date de lancement calculée automatiquement à la validation ("Oui"), avant création de la fiche Brand
  scheduledDate       DateTime?
  // Marque comme faisant partie du lot "à qualifier" de la Session du jour (persiste tant que le
  // statut reste PENDING, pour ne pas re-tirer un nouveau lot aléatoire à chaque ouverture).
  queuedForSessionAt  DateTime?
  importedAt          DateTime  @default(now())
  integratedAt        DateTime?
  brandId             String?   @unique
  brand               Brand?    @relation(fields: [brandId], references: [id])
}

// Rappel programmable librement (date + libellé), indépendant du calcul automatique des relances.
// Rattaché soit à une marque, soit à un projet (jamais les deux) — brandId/projectId nullables.
model Reminder {
  id        String   @id @default(cuid())
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  date      DateTime
  label     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactHistoryEntry {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  date      DateTime
  type      String
  content   String?
  // Canal utilisé pour cette action de prospection : "LINKEDIN" | "INSTAGRAM" | "EMAIL" |
  // "FORMULAIRE". Absent (null) = historique d'avant ce champ, ou action sans canal
  // pertinent (ex : note libre) — on suppose alors le DM classique de la marque.
  channel   String?
  createdAt DateTime @default(now())
}

model SectorOption {
  id    String @id @default(cuid())
  label String @unique
}

model SourceOption {
  id    String @id @default(cuid())
  label String @unique
}

model Settings {
  id                   String  @id @default("singleton")
  daysBeforeGreenLight Int     @default(15)
  daysBeforeRelance1   Int     @default(15)
  daysBeforeRelance2   Int     @default(15)
  daysBeforeDevisRelance1 Int  @default(15)
  daysBeforeDevisRelance2 Int  @default(15)
  daysBeforeFactureRelance1 Int @default(15)
  daysBeforeFactureRelance2 Int @default(15)
  // Nombre minimum de jours ouvrés entre deux passages en routine d'engagement sur une même
  // marque (like/commentaire) — évite de relancer une marque tous les jours.
  daysBetweenEngagements Int @default(3)
  emailNotifications   Boolean @default(false)
}

// ---- Squelette Phase 2 (créé mais inutilisé en Phase 1) ----

enum ServiceType {
  LA_PATTE
  LEMPREINTE
  SITE_ONE_PAGE
  SITE_VITRINE
  KIT_RS
  GRAPHISME_A_LA_CARTE
  ACCOMPAGNEMENT_MENSUEL
  ECOLES
  JURY
}

model Client {
  id            String         @id @default(cuid())
  brandId       String         @unique
  brand         Brand          @relation(fields: [brandId], references: [id])
  createdAt     DateTime       @default(now())
  projects      Project[]
  quoteRequests QuoteRequest[]
}

// Nouvelle demande de devis pour un client déjà existant (ex : marque créée directement,
// ou ancien projet déjà terminé), en parallèle d'éventuels autres projets/demandes en cours
// pour ce même client. Contrairement à Brand, qui ne porte qu'un seul statut de prospection à
// la fois, plusieurs QuoteRequest peuvent coexister pour un même Client. Réutilise le même enum
// PipelineStatus que Brand (restreint aux statuts liés au devis dans l'UI, cf. lib/quoteRequests.ts)
// pour profiter des mêmes libellés/couleurs/calculs de relance.
model QuoteRequest {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label            String?
  serviceTypes     ServiceType[]
  status           PipelineStatus @default(DEVIS_A_FAIRE)
  potentialRevenue Float?
  lastContactDate  DateTime?
  nextActionDate   DateTime?
  // Date de rappel choisie quand le statut passe à "Pas maintenant" — indépendante de celle
  // de la marque elle-même (une marque peut avoir un historique clos pendant qu'une nouvelle
  // demande de devis est mise en pause séparément).
  reconsiderDate   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Project {
  id                    String        @id @default(cuid())
  clientId              String
  client                Client        @relation(fields: [clientId], references: [id])
  serviceType           ServiceType
  // Nom libre (optionnel) : utile pour distinguer les occurrences d'un projet récurrent
  // (ex : "École - Juin", "École - Juillet") ou un abonnement. Sans nom, l'app retombe sur
  // le libellé du type de prestation.
  name                  String?
  currentStep           String
  // Étapes propres au projet (statuts personnalisés). Vide = modèle par défaut du type
  // de prestation (lib/serviceTypes.ts). Non vide = liste ordonnée complète pour ce projet.
  steps                 String[]      @default([])
  signedAt              DateTime?
  startDate             DateTime?
  estimatedDeliveryDate DateTime?
  quoteAmount           Float?
  notes                 String?
  // Posée automatiquement quand currentStep passe à "Terminé" (et effacée si le projet en
  // ressort) — alimente la vue annuelle des projets archivés (lib/projects.ts).
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  invoices              Invoice[]
  trackingNotes         ProjectNote[]
  reminders             Reminder[]
}

// Note de suivi datée, propre à un projet (même principe que le Suivi de la fiche prospect).
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  content   String
  createdAt DateTime @default(now())
}

// Facture libre par projet (acompte, solde, paiement en 3x/4x...) : nombre et montants
// laissés entièrement à la main, aucune date n'est jamais pré-remplie automatiquement.
model Invoice {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  amount    Float
  sentAt    DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

enum PriceType {
  FIXED
  HOURLY
  MONTHLY
}

// Grille tarifaire — gérée depuis l'interface (Phase 2, étape "Grille tarifaire").
model Service {
  id        String    @id @default(cuid())
  name      String
  category  String
  price     Float
  priceType PriceType @default(FIXED)
  content   String?
  active    Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
}

// Bundle = regroupement de prestations avec une remise automatique.
model Bundle {
  id              String   @id @default(cuid())
  name            String
  serviceIds      String[]
  discountPercent Float    @default(10)
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// Espace personnel sur le Dashboard, indépendant de tout client/projet : liste de tâches
// libres (pense-bête) + un bloc de notes en texte libre.
model DashboardTask {
  id        String    @id @default(cuid())
  label     String
  completed Boolean   @default(false)
  // Optionnelle : une tâche datée d'aujourd'hui (ou en retard) apparaît aussi dans
  // "Relances du jour", à côté des autres relances.
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

model DashboardNote {
  id        String   @id @default("singleton")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}
